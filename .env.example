# ── Leave everything empty to run in PREVIEW MODE (in-process database with sample data, persona sign-in). ──

# Public site URL (used in emails and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Production database (Supabase Postgres). Use the transaction pooler URI (port 6543). ──
DATABASE_URL=

# ── Supabase Auth (Dashboard → Project Settings → API). Publishable key is safe in the browser; the secret key is NOT. ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ── Email (Resend). Without a key, emails are written to the Email log in Admin. ──
RESEND_API_KEY=
EMAIL_FROM="BAUBC <notify@your-domain.org>"

# ── Webhook secrets (also set in each Apps Script's Script Properties) ──
GOOGLE_FORM_WEBHOOK_SECRET=
GMAIL_WEBHOOK_SECRET=

# ── Job worker: Vercel Cron sends "Authorization: Bearer $CRON_SECRET" ──
CRON_SECRET=

# ── Preview mode cookie signing (any long random string) ──
PREVIEW_SECRET=
