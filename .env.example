# ── Leave everything empty to run in PREVIEW MODE (in-process database with sample data, persona sign-in). ──

# Public site URL (used in emails and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Production database. Supabase Dashboard → Connect → "Transaction pooler" (port 6543), with your database password.
# postgresql://postgres.oinrhzcawnxkqvjyfbja:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ── Supabase Auth (Dashboard → Project Settings → API). Publishable key is safe in the browser; the secret key is NOT. ──
# Defaults to the club project (oinrhzcawnxkqvjyfbja). Both are public values.
NEXT_PUBLIC_SUPABASE_URL=https://oinrhzcawnxkqvjyfbja.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_nUWO8j7-7msDVYZVeCEBew_a3-023rY
# Optional. Not needed: activation works through the database sign-up gate. Never expose it to the browser.
SUPABASE_SECRET_KEY=

# ── Email (Resend). Without a key, emails are written to the Email log in Admin. ──
RESEND_API_KEY=
EMAIL_FROM="BAUBC <notify@your-domain.org>"

# ── Webhook secrets (also set in each Apps Script's Script Properties) ──
GOOGLE_FORM_WEBHOOK_SECRET=
GMAIL_WEBHOOK_SECRET=

# ── Job worker: Vercel Cron sends "Authorization: Bearer $CRON_SECRET" ──
CRON_SECRET=

# ── Preview mode cookie signing (any long random string) ──
PREVIEW_SECRET=

# ── First run: any random string of 16+ characters. Open /setup once to create the two Super Admins, then delete this. ──
SETUP_TOKEN=

# ── Set to "true" only after enabling the Google provider in Supabase Auth ──
AUTH_GOOGLE_ENABLED=
